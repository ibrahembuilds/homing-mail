# Homing settings: the mail server and the campaign service.
# install.sh fills in the __PLACEHOLDERS__ and writes homing.env (mode 600).
# After editing homing.env, run ./install.sh again to apply it.

###################################
# Brand
###################################
SITENAME=__BRAND_NAME__
BRAND_NAME=__BRAND_NAME__
WEBSITE=__WEBSITE__
LOGO_URL=/logo.svg
LOGO_BACKGROUND=__BRAND_COLOR__
BRAND_COLOR=__BRAND_COLOR__

###################################
# Identity
###################################
DOMAIN=__DOMAIN__
HOSTNAMES=__HOSTNAME__
POSTMASTER=postmaster
SECRET_KEY=__SECRET_KEY__
SUBNET=192.168.203.0/24
TZ=__TZ__

# First administrator (created on first start only)
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=__DOMAIN__
INITIAL_ADMIN_PW=__ADMIN_PASSWORD__
INITIAL_ADMIN_MODE=ifmissing

###################################
# Security
###################################
# letsencrypt: certificates are requested automatically (needs ports 80/443
# and the hostname's DNS record pointing at this server).
TLS_FLAVOR=__TLS_FLAVOR__
# Listeners the proxy opens (587 added for mail apps that expect it).
PORTS=25,80,443,465,587,993,4190
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day
DISABLE_STATISTICS=True

###################################
# Features
###################################
ADMIN=true
WEBMAIL=roundcube
# The mail server's user API: Homing uses it to create mailboxes for new team
# members. It is not reachable from the internet (see the proxy routes).
API=true
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=false

###################################
# Mail
###################################
MESSAGE_SIZE_LIMIT=50000000
# Per mailbox user. Campaign mail is paced by the campaign service instead.
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=
FETCHMAIL_ENABLED=False
RECIPIENT_DELIMITER=+
DMARC_RUA=postmaster
DMARC_RUF=postmaster
WELCOME=false
WELCOME_SUBJECT=Welcome to your new email account
WELCOME_BODY=Welcome to your new email account, if you can read this, then it is configured properly!
COMPRESSION=
COMPRESSION_LEVEL=
FULL_TEXT_SEARCH=en
FULL_TEXT_SEARCH_ATTACHMENTS=false
REJECT_UNLISTED_RECIPIENT=yes

###################################
# Web
###################################
WEBROOT_REDIRECT=/campaigns
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api

###################################
# Advanced
###################################
COMPOSE_PROJECT_NAME=__PROJECT__
CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
LOG_LEVEL=INFO
DEFAULT_SPAM_THRESHOLD=80
API_TOKEN=__API_TOKEN__

###################################
# Campaign service
###################################
# Signs tracking and unsubscribe links. Changing it breaks links in mail already sent.
CAMPAIGNS_SECRET=__CAMPAIGNS_SECRET__
# Shared with the web proxy (overrides/nginx/campaigns.conf) to prove an admin is signed in.
CAMPAIGNS_PROXY_SECRET=__PROXY_SECRET__
# Mailbox that receives bounces and spam complaints (created by install.sh).
CAMPAIGNS_BOUNCE_ADDRESS=bounces@__DOMAIN__
CAMPAIGNS_IMAP_USER=bounces@__DOMAIN__
CAMPAIGNS_IMAP_PASSWORD=__BOUNCE_PASSWORD__
# Default sending address, and the mailbox read for replies (created by install.sh).
CAMPAIGNS_FROM_EMAIL=hello@__DOMAIN__
CAMPAIGNS_REPLY_USER=hello@__DOMAIN__
CAMPAIGNS_REPLY_PASSWORD=__HELLO_PASSWORD__
# Public address of this server (shown on the domain setup page).
PUBLIC_IP=__PUBLIC_IP__
# Set to 1 to allow webhooks to addresses on your own network (a self-hosted n8n, for example).
CAMPAIGNS_WEBHOOK_PRIVATE=0
